# Public site URL (canonical links, sitemap, Open Graph). Set to the real domain once you have one.
# If unset, Vercel's production domain (VERCEL_PROJECT_PRODUCTION_URL) is used automatically.
# NEXT_PUBLIC_SITE_URL=https://your-domain.tn

# Quote form e-mail (Resend, https://resend.com). Without RESEND_API_KEY the form only logs in dev
# and shows a "call us" message in production.
RESEND_API_KEY=
QUOTE_TO_EMAIL=devis@example.com
QUOTE_FROM_EMAIL=Digital Power <onboarding@resend.dev>
